# Environment Variables Template
# AI-Powered Student Achievement Intelligence Platform — Member 3

# Application Settings
PROJECT_NAME="AI-Powered Student Achievement Intelligence Platform"
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Security & Authentication
SECRET_KEY="generate_random_secret_key_here_for_jwt_signing"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection
# SQLite (Default Local):
DATABASE_URL="sqlite:///student_intelligence.db"
# PostgreSQL (Production Staging):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/student_intelligence"

# Recommendation Algorithm Weights (Must sum to 1.0)
WEIGHT_SEMANTIC=0.45
WEIGHT_SKILL=0.30
WEIGHT_DOMAIN=0.15
WEIGHT_URGENCY=0.10

# Aggregation Parameters
ACHIEVEMENT_HALF_LIFE_DAYS=730.0
VERIFIED_ACHIEVEMENT_MULTIPLIER=1.25
MIN_CELL_SUPPRESSION_THRESHOLD=3

# Frontend API URL
VITE_API_URL="http://localhost:8000/api/v1"
API_URL="http://localhost:8000/api/v1"
